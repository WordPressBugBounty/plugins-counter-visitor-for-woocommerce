msgstr "Vóór productoverzicht"

#: views/options.php:386
msgid "After product summary"
msgstr "Na productoverzicht"

#: views/options.php:387
msgid "Product Thumbnail (may not work)"
msgstr "Productminiatuur (werkt mogelijk niet)"

#: views/options.php:388
msgid "After short description"
msgstr "Na korte beschrijving"

#: views/options.php:389
msgid "Deactivate"
msgstr "Deactiveren"

#: views/options.php:396
msgid "Weight block"
msgstr "Gewicht blok"

#: views/options.php:397
msgid "The heavier the weight, the lower the block is displayed"
msgstr "Hoe zwaarder het gewicht, hoe lager het blok wordt weergegeven"

#: views/options.php:407
msgid "Fake Mode"
msgstr "Valse modus"

#: views/options.php:408
msgid "Use Random numbers between from / to"
msgstr "Gebruik willekeurige getallen tussen van / tot"

#: views/options.php:418
msgid "Random Numbers"
msgstr "Willekeurige getallen"

#: views/options.php:419
msgid "Need Fake mode, for visitors this value is saved for 25 minutes"
msgstr "Fake-modus nodig, voor bezoekers wordt deze waarde 25 minuten bewaard"

#: views/options.php:424
msgid "From:"
msgstr "Van:"

#: views/options.php:428
msgid "To:"
msgstr "Naar:"

#: views/options.php:436
msgid "Icon"
msgstr "Icon"

#: views/options.php:437
msgid ""
"You can use always icon, fontawesome, only class name for example: fas fa-"
"eye"
msgstr ""
"U kunt altijd het pictogram, fontawesome en alleen de klassenaam gebruiken, "
"bijvoorbeeld: fas fa-eye"

#: views/options.php:447
msgid "¿Problem with Icon?"
msgstr "¿Probleem met Icoon?"

#: views/options.php:448
msgid "Load FontAwesome Library."
msgstr "Laad FontAwesome-bibliotheek."

#: views/options.php:459
msgid "Message more than one user"
msgstr "Stuur meer dan één gebruiker een bericht"

#: views/options.php:460
msgid "%n is replaced by number visitors"
msgstr "%n wordt vervangen door aantal bezoekers"

#: views/options.php:470
msgid "Message only one user"
msgstr "Stuur slechts één gebruiker een bericht"

#: views/options.php:480
msgid "Save"
msgstr "Redden"

#: views/options.php:488
msgid "Do you want to receive the latest?"
msgstr "Wil je het laatste ontvangen?"

#: views/options.php:489
msgid ""
"Thank you very much for using our plugin, if you want to receive the latest "
"news, offers, promotions, discounts, etc ... Sign up for our newsletter. :)"
msgstr ""
"Hartelijk dank voor het gebruik van onze plugin, als u het laatste nieuws, "
"aanbiedingen, promoties, kortingen, enz. wilt ontvangen... Schrijf u dan in "
"voor onze nieuwsbrief. :)"

#: views/options.php:494
msgid "Required"
msgstr "Vereist"

#: views/options.php:499
msgid "Submit"
msgstr "Indienen"

#: views/options.php:499
msgid "Processing"
msgstr "Verwerking"

#: views/options.php:505
msgid "Need style?"
msgstr "Stijl nodig?"

#: views/options.php:506
msgid "Enjoy! Paste this CSS code into your Customizer and edit as you like"
msgstr ""
"Genieten! Plak deze CSS-code in uw customizer en bewerk hem zoals u wilt"

#: views/stats.php:277
msgid ""
"Real statistics are only stored when Fake Mode is disabled. Use this panel "
"to identify products with the most traffic and recurring interest."
msgstr ""
"Echte statistieken worden alleen opgeslagen als de Fake-modus is "
"uitgeschakeld. Gebruik dit paneel om producten te identificeren met het "
"meeste verkeer en terugkerende interesse."

#: views/stats.php:278
#, php-format
msgid "Statistics retention: %d days. Older visits are deleted automatically."
msgstr ""
"Bewaren van statistieken: %d dagen. Oudere bezoeken worden automatisch "
"verwijderd."

#: views/stats.php:279
#, php-format
msgid ""
"Archived page views: %s. Daily totals are kept after individual visits are "
