msgstr "Produkt-Miniaturansicht (funktioniert möglicherweise nicht)"

#: views/options.php:388
msgid "After short description"
msgstr "Nach kurzer Beschreibung"

#: views/options.php:389
msgid "Deactivate"
msgstr "Deaktivieren"

#: views/options.php:396
msgid "Weight block"
msgstr "Gewichtsblock"

#: views/options.php:397
msgid "The heavier the weight, the lower the block is displayed"
msgstr "Je schwerer das Gewicht, desto niedriger wird der Block angezeigt"

#: views/options.php:407
msgid "Fake Mode"
msgstr "Fake-Modus"

#: views/options.php:408
msgid "Use Random numbers between from / to"
msgstr "Verwenden Sie Zufallszahlen zwischen von / bis"

#: views/options.php:418
msgid "Random Numbers"
msgstr "Zufallszahlen"

#: views/options.php:419
msgid "Need Fake mode, for visitors this value is saved for 25 minutes"
msgstr ""
"Fake-Modus erforderlich, für Besucher wird dieser Wert 25 Minuten lang "
"gespeichert"

